# 실습용 MySQL 설정입니다. 운영 환경에 그대로 쓰지 마세요.
# 데이터를 빨리 넣고, 측정 조건을 일정하게 유지하는 데 초점을 맞췄습니다.

[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
default-time-zone    = '+09:00'

# 메모리 캐시(버퍼 풀) 크기. 데이터가 여기에 올라와 있으면 디스크를 읽지 않습니다.
# 측정 결과에 큰 영향을 주므로 실험 중에는 바꾸지 마세요.
innodb_buffer_pool_size = 1G

# 대량 데이터 적재 속도를 위한 설정 (안정성보다 속도 우선 = 실습 전용)
innodb_flush_log_at_trx_commit = 2
innodb_redo_log_capacity       = 1G
disable_log_bin

# 느린 쿼리 기록 (0.2초 이상 걸린 쿼리가 /var/lib/mysql/slow.log 에 남음)
slow_query_log      = ON
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 0.2

performance_schema = ON

# 인덱스 컨디션 푸시다운(ICP, EXPLAIN 의 "Using index condition") 카운터 켜기
# → 측정 도구가 "인덱스 안에서 몇 개를 검사하고 버렸는지"까지 셀 수 있음
innodb_monitor_enable = module_icp
max_allowed_packet = 64M

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
